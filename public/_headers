/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; img-src 'self'; style-src 'self'; font-src 'self'; script-src 'self' https://hits.jonbailey.xyz; connect-src 'self' https://hits.jonbailey.xyz; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

/previews/*
  Cache-Control: public, max-age=86400

/fonts/*
  Cache-Control: public, max-age=2592000

/og.jpg
  Cache-Control: public, max-age=86400
  Content-Type: image/jpeg

/og.png
  Cache-Control: public, max-age=86400
  Content-Type: image/png

/llms.txt
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8

/sitemap.xml
  Cache-Control: public, max-age=3600

/VERSION
  Cache-Control: public, max-age=300
  Content-Type: text/plain; charset=utf-8

/apple-touch-icon.png
  Cache-Control: public, max-age=86400
  Content-Type: image/png

/icon-192.png
  Cache-Control: public, max-age=86400
  Content-Type: image/png

/icon-512.png
  Cache-Control: public, max-age=86400
  Content-Type: image/png
